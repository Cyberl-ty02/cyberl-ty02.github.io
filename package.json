{
  "name": "cyberl-ty02-blog",
  "description": "Cyberl-ty02 的 Bun、TypeScript 与 Hexo 博客",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyberl-ty02/cyberl-ty02.github.io.git"
  },
  "scripts": {
    "build": "bun run check && bun run build:runtime && bun run build:site && bun run check:generated",
    "build:runtime": "bun run tools/build-runtime.ts",
    "build:site": "hexo generate",
    "check": "bun run check:types && bun run test:contracts && bun run check:content",
    "check:content": "bun run tools/check-content.ts",
    "check:generated": "bun run tools/check-generated.ts",
    "check:types": "tsc --noEmit",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "bun run build:runtime && hexo server",
    "test:contracts": "bun test tests"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "overrides": {
    "brace-expansion": "2.1.2",
    "dompurify": "3.4.12",
    "form-data": "4.0.6",
    "glob": "^10.3.10",
    "js-yaml": "4.3.0",
    "morgan": "1.11.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@waline/client": "3.15.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-cli": "^4.3.2",
    "hexo-front-matter": "4.2.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-kratos-rebirth": "3.0.1",
    "isomorphic-git": "1.42.2",
    "moment": "2.31.0"
  }
}
